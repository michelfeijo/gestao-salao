// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Salao {
  id        String   @id @default(cuid())
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios          Usuario[]
  clientes          Cliente[]
  profissionais     Profissional[]
  categoriasServico CategoriaServico[]
  servicos          Servico[]
  agendamentos      Agendamento[]

  @@map("saloes")
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senha     String
  role      String   @default("admin")
  idSalao   String
  salao     Salao    @relation(fields: [idSalao], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([idSalao])
  @@map("usuarios")
}

model Cliente {
  id             String   @id @default(cuid())
  idSalao        String
  salao          Salao    @relation(fields: [idSalao], references: [id])
  cpf            String
  nome           String
  telefone       String
  dataNascimento DateTime @db.Date
  genero         String
  email          String?
  cep            String?
  rua            String?
  numero         String?
  complemento    String?
  bairro         String?
  cidade         String?
  estado         String?
  observacoes    String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  agendamentos Agendamento[]

  @@unique([idSalao, cpf])
  @@index([idSalao])
  @@map("clientes")
}

model Profissional {
  id             String    @id @default(cuid())
  idSalao        String
  salao          Salao     @relation(fields: [idSalao], references: [id])
  nome           String
  telefone       String
  email          String?
  cpf            String?
  cargo          String
  especialidades String?
  cor            String
  dataInicio     DateTime? @db.Date
  ativo          Boolean   @default(true)
  observacoes    String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  servicos     Servico[]
  agendamentos Agendamento[]

  @@unique([idSalao, cpf])
  @@index([idSalao])
  @@map("profissionais")
}

model CategoriaServico {
  id        String   @id @default(cuid())
  idSalao   String
  salao     Salao    @relation(fields: [idSalao], references: [id])
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  servicos Servico[]

  @@unique([idSalao, nome])
  @@index([idSalao])
  @@map("categorias_servico")
}

model Servico {
  id             String           @id @default(cuid())
  idSalao        String
  salao          Salao            @relation(fields: [idSalao], references: [id])
  nome           String
  idCategoria    String
  categoria      CategoriaServico @relation(fields: [idCategoria], references: [id])
  duracaoMinutos Int
  preco          Decimal          @db.Decimal(10, 2)
  ativo          Boolean          @default(true)
  observacoes    String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  profissionais Profissional[]
  agendamentos  Agendamento[]

  @@unique([idSalao, nome])
  @@index([idSalao])
  @@index([idCategoria])
  @@map("servicos")
}

model Agendamento {
  id             String       @id @default(cuid())
  idSalao        String
  salao          Salao        @relation(fields: [idSalao], references: [id])
  idCliente      String
  cliente        Cliente      @relation(fields: [idCliente], references: [id])
  idProfissional String
  profissional   Profissional @relation(fields: [idProfissional], references: [id])
  idServico      String
  servico        Servico      @relation(fields: [idServico], references: [id])
  inicio         DateTime
  fim            DateTime
  status         String       @default("agendado")
  observacoes    String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([idSalao])
  @@index([idProfissional, inicio])
  @@index([idCliente])
  @@map("agendamentos")
}
